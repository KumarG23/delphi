# Copy to .env and fill in. .env is gitignored.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Tailnet-only Hermes PDF parser. Validates the user's Supabase session.
EXPO_PUBLIC_STATEMENT_IMPORT_URL=https://your-hermes-tailnet-name:8443/delphi-import

# Ask Delphi: base URL of the Ollama host running the delphi-cat-coach model.
# Local hermes3:8b on the Z420, reached over Tailscale.
EXPO_PUBLIC_OLLAMA_URL=http://100.66.106.122:11434
