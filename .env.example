# Copy to .env and fill in. .env is gitignored.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase credential used by Vercel API routes.
# Never expose this with an EXPO_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plaid Sandbox. Keep these server-side only.
PLAID_CLIENT_ID=your-sandbox-client-id
PLAID_SECRET=your-sandbox-secret
PLAID_ENV=sandbox

# Optional statement-import service endpoint used during development.
EXPO_PUBLIC_STATEMENT_IMPORT_URL=https://your-private-service.example/delphi-import

# Ask Delphi: base URL of the local/private Ollama host used during development.
EXPO_PUBLIC_OLLAMA_URL=http://your-private-ollama-host:11434
